# PostgreSQL (docker-compose service "postgres")
DATABASE_URL="postgresql://vanguard:vanguard@localhost:5432/vanguard"

# better-auth secret (generate: openssl rand -base64 32)
BETTER_AUTH_SECRET="change-me"
BETTER_AUTH_URL="http://localhost:3000"
# extra origins allowed to call the auth API, comma-separated (LAN IP etc.)
# BETTER_AUTH_TRUSTED_ORIGINS="http://192.168.1.10:3000"

# SMTP for OTP email
# Dev: mailhog on localhost:1025
# SMTP_URL="smtp://localhost:1025"
# Live (Gmail app password): smtps:// for implicit TLS on 465, or smtp://...:587 for STARTTLS
SMTP_URL="smtps://youremail@gmail.com:YOUR_GMAIL_APP_PASSWORD@smtp.gmail.com:465"
MAIL_FROM="Vanguard <youremail@gmail.com>"

# Sentinel SOC middleware (Sprint 5). Leave unset to keep deterministic mock correlation.
SENTINEL_BASE_URL="https://sentinel.internal"
SENTINEL_READ_KEY="sk-read-..."
SENTINEL_WRITE_KEY="sk-write-..."
